{
  "name": "PasswordResetOtp",
  "type": "object",
  "properties": {
    "accountEmail": {
      "type": "string",
      "description": "The account email this OTP was issued for"
    },
    "otpHash": {
      "type": "string",
      "description": "SHA-256 hash of the OTP salted with the account email"
    },
    "expiresAt": {
      "type": "string",
      "description": "ISO timestamp after which the OTP is invalid"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Failed verification attempts"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "True once the OTP was verified or invalidated"
    },
    "delivered": {
      "type": "boolean",
      "default": false,
      "description": "Whether the OTP email was successfully delivered"
    }
  },
  "required": [
    "accountEmail",
    "otpHash",
    "expiresAt"
  ]
}